{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run start",
    "start": "node scripts/start-dev.js",
    "build": "node scripts/build-docs.js",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "clean": "docusaurus clear",
    "serve": "docusaurus serve",
    "format": "npx dprint fmt",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "generate-platform-api": "npx rimraf docs/management-api docs/deployment-api docs/public-deployment-api && npx docusaurus gen-api-docs all",
    "spellcheck": "cspell \"docs/**/*.md*\"",
    "typecheck": "tsc",
    "test": "cspell \"docs/**/*.md*\" && node test.js"
  },
  "dependencies": {
    "@docusaurus/core": "~3.10.1",
    "@docusaurus/faster": "~3.10.1",
    "@docusaurus/preset-classic": "~3.10.1",
    "@fontsource/inter": "^5.2.6",
    "@mdx-js/react": "~3.1.0",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.1.0",
    "clsx": "2.1.1",
    "prism-react-renderer": "~2.4.1",
    "prism-svelte": "0.5.0",
    "raw-loader": "4.0.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "convex": "workspace:*",
    "@docusaurus/theme-common": "~3.10.1",
    "heroicons": "^2.0.16",
    "react-dropdown": "~1.11.0",
    "algoliasearch": "~4.27.0",
    "react-markdown": "~10.1.0",
    "@types/react": "^18.0.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.18",
    "@radix-ui/react-icons": "~1.3.0",
    "@convex-internal/web-analytics": "2.2.2",
    "dotenv": "^16.4.7",
    "@docusaurus/plugin-content-docs": "~3.10.1",
    "copy-text-to-clipboard": "^3.2.0",
    "degit": "^2.8.6",
    "docusaurus-plugin-openapi-docs": "~5.2.0",
    "docusaurus-theme-openapi-docs": "~5.2.0",
    "sonner": "^2.0.0"
  },
  "devDependencies": {
    "@convex-dev/platform": "workspace:*",
    "docusaurus-plugin-typedoc": "npm:@convex-dev/docusaurus-plugin-typedoc@0.19.2",
    "typedoc-plugin-markdown": "npm:@convex-dev/typedoc-plugin-markdown@3.15.6",
    "@docusaurus/module-type-aliases": "~3.10.1",
    "@docusaurus/tsconfig": "~3.10.1",
    "typescript": "~5.0.3",
    "webpack": "^5.104.1",
    "@docusaurus/types": "~3.10.1",
    "cspell": "^6.30.2",
    "detect-port": "^2.1.0",
    "@types/node": "^18.17.0",
    "@docusaurus/theme-classic": "~3.10.1",
    "prettier": "3.8.1",
    "tailwind-merge": "^3.3.1",
    "postcss-nested": "~7.0.2",
    "rimraf": "6.1.3",
    "copyfiles": "2.4.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
