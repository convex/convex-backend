{
  "name": "dashboard-self-hosted",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:generated && next dev --port 6790",
    "build": "npm run build:generated && next build",
    "build:generated": "python3 ../dashboard-common/scripts/build-convexServerTypes.py",
    "build:export": "BUILD_TYPE=export NEXT_PUBLIC_USE_CURRENT_DEPLOYMENT_API=true NEXT_PUBLIC_DEFAULT_LIST_DEPLOYMENTS_API_PORT=6791 npm run build",
    "start": "next start -p 6791",
    "lint": "bash ../dashboard-common/scripts/checkNode24.sh && npx --prefix ../lint eslint . --config ../lint/eslint.config.mjs --cache && tsc",
    "lint:fix": "bash ../dashboard-common/scripts/checkNode24.sh && npx --prefix ../lint eslint --fix . --config ../lint/eslint.config.mjs --cache"
  },
  "dependencies": {
    "@convex-dev/design-system": "workspace:*",
    "@radix-ui/react-icons": "~1.3.0",
    "convex": "workspace:*",
    "dashboard-common": "workspace:*",
    "next": "^16.4.1",
    "next-themes": "~0.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-use": "~17.6.0",
    "system-udfs": "workspace:*",
    "zod": "^3.24.0",
    "@monaco-editor/react": "4.7.0",
    "monaco-editor": "0.40.0"
  },
  "devDependencies": {
    "@storybook/nextjs": "^10.6.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.18",
    "storybook": "^10.6.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
