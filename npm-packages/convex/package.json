    "@swc/core": "1.15.8",
    "@testing-library/react": "~16.3.0",
    "@types/babel__code-frame": "^7.0.6",
    "@types/deep-equal": "1.0.4",
    "@types/node": "^18.17.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
