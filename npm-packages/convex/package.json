    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-require-extensions": "~0.1.3",
    "fetch-retry": "~6.0.0",
    "find-up": "^8.0.0",
    "globals": "~17.4.0",
    "happy-dom": "~20.10.0",
    "jsdom": "~28.1.0",
    "json5": "~2.2.3",
    "knip": "~5.86.0",
    "napi-wasm": "1.1.3",
    "open": "^11.0.0",
