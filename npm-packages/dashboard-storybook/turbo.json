{
  "extends": ["//"],
  "tasks": {
    "build": {
      // Every workspace dependency of `dashboard`, but not `dashboard` itself:
      // the Storybook build compiles the dashboard's source, so it needs those
      // dists, while the dashboard's own `next build` takes ~7 minutes and
      // produces nothing this reads. Inheriting `^build` would run it.
      "dependsOn": [
        "@convex-dev/design-system#build",
        "@convex-dev/platform#build",
        "convex#build",
        "convex-analytics#build",
        "dashboard-common#build",
        "shapes#build",
        "system-udfs#build"
      ],
      // Storybook reads dashboard source, static assets, and Next/PostCSS config,
      // plus both apps' TypeScript/package metadata. Allowlisting these inputs
      // keeps gitignored Next outputs and Turbo logs out of the build hash.
      // The dependencies built above contribute their own task hashes.
      "inputs": [
        "$TURBO_DEFAULT$",
        "../dashboard/src/**",
        "../dashboard/public/**",
        "../dashboard/package.json",
        "../dashboard/tsconfig.json",
        "../dashboard/next.config.js",
        "../dashboard/postcss.config.js",
        "../dashboard/.env*",
        "../dashboard-self-hosted/src/**",
        "../dashboard-self-hosted/package.json",
        "../dashboard-self-hosted/tsconfig.json"
      ],
      "outputs": ["storybook-static/**"]
    }
  }
}
