{
  "name": "@convex-dev/eslint-plugin",
  "version": "5.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://docs.convex.dev/eslint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/convex/convex-backend.git",
    "directory": "npm-packages/@convex-dev/eslint-plugin"
  },
  "scripts": {
    "build": "tshy",
    "test": "vitest run && node src/scripts/version-check.mjs",
    "test:types": "tsc --noEmit",
    "test:watch": "vitest",
    "prepublishOnly": "node src/scripts/version-check.mjs && npm run build",
    "prepack": "node src/scripts/dont-publish-alpha-as-latest.mjs"
  },
  "dependencies": {
    "@typescript-eslint/parser": "~8.58.0",
    "@typescript-eslint/types": "~8.58.0",
    "@typescript-eslint/utils": "~8.58.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "convex": "^1.43.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.0",
    "@types/eslint": "~9.6.1",
    "@types/node": "^18.17.0",
    "@typescript-eslint/rule-tester": "~8.58.0",
    "convex": "workspace:*",
    "eslint": "^9.37.0",
    "globals": "~17.4.0",
    "tshy": "^3.0.0",
    "typescript-eslint": "^8.45.0",
    "vitest": "^4.1.0"
  },
  "tshy": {
    "dialects": [
      "esm",
      "commonjs"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "exclude": [
      "src/**/*.test.ts",
      "src/test/helpers.ts",
      "src/test/fixtures/**"
    ],
    "selfLink": false
  },
  "files": [
    "dist",
    "src/index.ts",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/esm/index.js",
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts"
}
