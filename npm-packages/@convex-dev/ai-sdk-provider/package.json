{
  "name": "@convex-dev/ai-sdk-provider",
  "version": "0.3.0",
  "description": "AI SDK provider for the Convex AI gateway",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/convex/convex-backend.git",
    "directory": "npm-packages/@convex-dev/ai-sdk-provider"
  },
  "scripts": {
    "build": "tshy",
    "test": "vitest run --typecheck",
    "test:types": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepack": "node src/scripts/publish.mjs --check",
    "publish-package": "node src/scripts/publish.mjs"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/evaluation-model.ts",
    "src/transcription-model.ts",
    "src/video-model.ts",
    "src/video-webhook.ts",
    "LICENSE"
  ],
  "tshy": {
    "dialects": [
      "esm",
      "commonjs"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "exclude": [
      "src/**/*.test.ts"
    ],
    "selfLink": false
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.40",
    "@ai-sdk/openai": "4.0.45",
    "@ai-sdk/openai-compatible": "3.0.14",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "ai": "^7.0.105",
    "convex": "^1.45.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^18.17.0",
    "ai": "7.0.105",
    "convex": "workspace:*",
    "tshy": "^3.0.0",
    "typescript": "~5.0.3",
    "vitest": "^4.1.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/esm/index.js",
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts"
}
