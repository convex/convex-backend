{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node checkBigBrain.mjs 6789 && npm run build:generated && next dev --port 6789",
    "dev:pure": "npm run dev",
    "build": "npm run build:generated && next build",
    "analyze": "npm run build:generated && next experimental-analyze",
    "build:generated": "npm run generateApiSpec && python3 ../dashboard-common/scripts/build-convexServerTypes.py",
    "start": "next start",
    "lint": "bash ../dashboard-common/scripts/checkNode24.sh && npx --prefix ../lint eslint . --config ../lint/eslint.config.mjs --cache && tsc",
    "lint:fix": "bash ../dashboard-common/scripts/checkNode24.sh && npx --prefix ../lint eslint --fix . --config ../lint/eslint.config.mjs --cache",
    "test": "npm run checkManagementApiSpec && npm run checkDeploymentApiSpec && npm run build:generated && jest",
    "clean": "shx rm -rf .next",
    "corsProxy": "node cors-proxy.js",
    "pullEnv": "vercel env pull .env.local",
    "generateApiSpec": "npm run generateManagementApiSpec && npm run generateDeploymentApiSpec",
    "checkApiSpec": "npm run checkManagementApiSpec && npm run checkDeploymentApiSpec",
    "generateManagementApiSpec": "openapi-typescript ./dashboard-management-openapi.json --output ./src/generatedApi.ts --root-types --root-types-no-schema-prefix",
    "generateDeploymentApiSpec": "openapi-typescript ./dashboard-deployment-openapi.json --output ./src/generatedDeploymentApi.ts --root-types --root-types-no-schema-prefix",
    "checkManagementApiSpec": "openapi-typescript ./dashboard-management-openapi.json --output ./src/generatedApi.ts --root-types --root-types-no-schema-prefix --check || (echo 'Dashboard API spec check failed. Run `just turbo run build --filter=dashboard...` to fix.'; false)",
    "checkDeploymentApiSpec": "openapi-typescript ./dashboard-deployment-openapi.json --output ./src/generatedDeploymentApi.ts --root-types --root-types-no-schema-prefix --check || (echo 'Dashboard API spec check failed. Run `just turbo run build --filter=dashboard...` to fix.'; false)"
  },
  "dependencies": {
    "@convex-dev/design-system": "workspace:*",
    "@convex-dev/platform": "workspace:*",
    "@floating-ui/react": "^0.27.0",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "2.2.0",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-icons": "~1.3.0",
    "@sentry/nextjs": "^10.75.2",
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.0.0",
    "@team-plain/typescript-sdk": "~5.11.0",
    "classnames": "^2.3.2",
    "cobe": "^0.6.5",
    "convex": "workspace:*",
    "convex-analytics": "workspace:*",
    "dashboard-common": "workspace:*",
    "shapes": "workspace:*",
    "date-fns": "^4.1.0",
    "fetch-retry": "~6.0.0",
    "formik": "^2.4.6",
    "jsonc-parser": "~3.3.0",
    "launchdarkly-js-client-sdk": "^3.9.0",
    "launchdarkly-react-client-sdk": "^3.0.4",
    "lodash": "~4.18.0",
    "monaco-editor": "0.40.0",
    "next": "^16.4.1",
    "nprogress": "~0.2.0",
    "react": "^19.2.4",
    "react-day-picker": "~9.14.0",
    "react-dom": "^19.2.4",
    "react-use": "~17.6.0",
    "react-window": "1.8.11",
    "recharts": "3.7.0",
    "swr": "^2.2.1",
    "system-udfs": "workspace:*",
    "yup": "~0.32.11",
    "zod": "^3.24.0",
    "swr-openapi": "~5.3.0",
    "openapi-fetch": "~0.17.0",
    "react-sparklines": "~1.7.0",
    "posthog-js": "~1.404.0",
    "shx": "~0.4.0",
    "cmdk": "~1.1.1",
    "react-hotkeys-hook": "~4.6.0",
    "@workos-inc/authkit-nextjs": "~2.17.0",
    "@workos-inc/node": "~7.69.0",
    "@workos-inc/widgets": "~1.15.0",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-query": "^5.100.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@jest/types": "^30.0.0",
    "@storybook/nextjs": "^10.6.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "~6.9.0",
    "@testing-library/react": "~16.3.0",
    "@testing-library/user-event": "~14.6.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "~4.17.0",
    "@types/node": "^18.17.0",
    "@types/nprogress": "~0.2.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.5",
    "@types/testing-library__jest-dom": "~5.14.5",
    "babel-loader": "^10.0.0",
    "chalk": "5",
    "dotenv": "^16.4.7",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jsdom-testing-mocks": "^1.16.0",
    "next-router-mock": "~1.0.0",
    "next-themes": "~0.4.0",
    "postcss": "^8.5.18",
    "storybook": "^10.6.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vercel": "^54.4.1",
    "webpack": "^5.104.1",
    "@testing-library/dom": "~10.4.0",
    "openapi-typescript": "~7.8.0",
    "openapi-typescript-helpers": "~0.1.0",
    "@types/react-sparklines": "~1.7.5"
  }
}
